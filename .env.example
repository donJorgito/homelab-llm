# homelab-llm environment configuration template
# Copy to .env and customize. .env is gitignored — never commit secrets.

# =============================================================================
# Server (the machine running Ollama with the GPU)
# =============================================================================

# Hostname or IP of the inference server (the box with NVIDIA GPU)
OLLAMA_HOST=192.0.2.143

# Ollama listen port (default 11434)
OLLAMA_PORT=11434

# Full base URL — derived from above, override only if behind reverse proxy
OLLAMA_BASE_URL=http://192.0.2.143:11434

# =============================================================================
# Storage (LVM volume for Ollama models)
# =============================================================================

# LVM volume group containing free PEs
LV_VG_NAME=vg0

# Logical volume name for Ollama model storage
LV_NAME=lv-ollama

# Logical volume size (use lvcreate-compatible suffix: M, G, T)
LV_SIZE=128G

# Mount point for the Ollama models LV
LV_MOUNT_POINT=/var/lib/ollama

# =============================================================================
# Ollama runtime tuning
# =============================================================================

# Context window per request (Ollama default 4096; raise for tool-use)
OLLAMA_CONTEXT_LENGTH=16384

# How long the model stays in VRAM after last request (Ollama default 5m)
OLLAMA_KEEP_ALIVE=30m

# =============================================================================
# Models to pull
# =============================================================================

# Comma-separated list of Ollama model tags to pull during 03-pull-models.sh
OLLAMA_MODELS=qwen2.5-coder:7b,qwen2.5-coder:3b

# Default model used by client (aider) when not overridden
DEFAULT_MODEL=qwen2.5-coder:7b

# =============================================================================
# Client (aider on Mac or Linux)
# =============================================================================

# aider edit format. Validated values for Qwen2.5-Coder family: whole, diff, udiff
AIDER_EDIT_FORMAT=whole

# Optional: override the model alias passed to aider (must include ollama_chat/ prefix)
AIDER_MODEL=ollama_chat/qwen2.5-coder:7b
